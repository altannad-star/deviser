def utf16_strings(data, min_chars=3):
    return [s.decode("utf-16-le") for s in re.findall(rb'(?:[\x20-\x7e]\x00){%d,}' % min_chars, data)]


def ascii_strings(data, min_chars=5):
    return [s.decode("ascii") for s in re.findall(rb'[\x20-\x7e]{%d,}' % min_chars, data)]


def filetime_to_iso(raw):
    if raw == 0:
        return None
    import datetime
    try:
        return (datetime.datetime(1601, 1, 1) + datetime.timedelta(microseconds=raw // 10)).isoformat()
    except Exception:
        return None


def decode_property_set(data):
    """Decode a standard OLE property-set stream -> {fmtid: [(id, type, value)]}."""
    if data[:8] != PROLOGUE:
        return {}
    numsec = struct.unpack_from("<I", data, 24)[0]
    sections = {}
    for s in range(numsec):
        fmtid = str(uuid.UUID(bytes_le=data[28 + s * 20:44 + s * 20]))
        sec_off = struct.unpack_from("<I", data, 44 + s * 20)[0]
        if sec_off + 8 > len(data):
            continue
        cnt = struct.unpack_from("<I", data, sec_off + 4)[0]
        props = []
        for i in range(cnt):
            pid, poff = struct.unpack_from("<II", data, sec_off + 8 + i * 8)
            o = sec_off + poff
            if o + 4 > len(data):
                continue
            typ = struct.unpack_from("<I", data, o)[0]
            try:
                if typ == VT_LPWSTR:
                    slen = struct.unpack_from("<I", data, o + 4)[0]
                    val = data[o + 8:o + 8 + slen * 2].decode("utf-16-le").rstrip("\x00")
                elif typ == VT_R8:
                    val = struct.unpack_from("<d", data, o + 4)[0]
                elif typ == VT_I4:
                    val = struct.unpack_from("<i", data, o + 4)[0]
                elif typ == VT_I2:
                    val = struct.unpack_from("<h", data, o + 4)[0]
                elif typ == VT_BOOL:
                    val = bool(struct.unpack_from("<H", data, o + 4)[0])
                elif typ == VT_FILETIME:
                    val = filetime_to_iso(struct.unpack_from("<Q", data, o + 4)[0])
                elif typ == VT_BLOB:
                    blen = struct.unpack_from("<I", data, o + 4)[0]
                    val = data[o + 8:o + 8 + blen]
                else:
                    val = data[o + 4:o + 20]
            except Exception:
                val = data[o + 4:o + 20]
            props.append((pid, typ, val))
        sections[fmtid] = props
    return sections



# ---------------- RSe / parameter layer (session 4) ----------------

ZSTD_MAGIC = b"\x28\xb5\x2f\xfd"

def _inflate_b_streams(ole):
    """Decompress all RSeStorage/B* zstd payloads."""
    try:
        import zstandard
    except ImportError:
        return []
    out = []
    for entry in ole.listdir(streams=True):
        path = "/".join(entry)
        v = ole.openstream(entry).read()
        if path.startswith("RSeStorage/B"):
            i = v.find(ZSTD_MAGIC)
            if i >= 0:
                try:
                    out.append(zstandard.ZstdDecompressor().decompress(v[i:], max_output_size=50_000_000))
                except Exception:
                    pass
    return out


def _scan_lp_strings(v):
    """All length-prefixed UTF-16LE strings in a payload: [(offset, text)]."""
    out = []
    i = 0
    while i < len(v) - 4:
        n = struct.unpack_from("<I", v, i)[0]
        if 1 <= n <= 60 and i + 4 + n * 2 <= len(v):
            s = v[i + 4:i + 4 + n * 2]
            if re.fullmatch(rb"(?:[\x20-\x7e]\x00){%d}" % n, s):
                out.append((i, s.decode("utf-16-le")))
                i += 4 + n * 2
                continue
        i += 2
    return out


def _extract_parameters_from_payload(v):
    """User parameters {name: value} from an RSe payload.

    Record grammar (spec session 9, ground-truth validated on params.ipt):
      0b <flags:3B> <u32 namelen> <UTF16 name> <u32 0> <format...>
    where format varies by parameter type:
      - numeric (length/angle/etc): <u32 id1> <u32 id2> <f64 value>
        (value in INTERNAL units: cm for length, radians for angle)
      - text: <u32 textlen> <UTF16 text> <u32 id> ...
    The <u32 0> separator and the id pair identify the unit/type.
    Fallback: legacy name+display-string heuristic (older reading, kept
    for unit-bearing display forms like '10 mm').
    """
    params = {}
    # primary: binary record scan
    i = 0
    while i < len(v) - 16:
        # record marker: bd 0b <flags:2B> <u32 namelen> (session-9 verified)
        if v[i] == 0xbd and v[i+1] == 0x0b and v[i+2:i+4] == b"\x00\x00":
            nlen = struct.unpack_from("<I", v, i+4)[0]
            if 1 <= nlen <= 60 and i+8+nlen*2 <= len(v):
                name_raw = v[i+8:i+8+nlen*2]
                if re.fullmatch(rb"(?:[\x20-\x7e]\x00){%d}" % nlen, name_raw):
                    name = name_raw.decode("utf-16-le")
                    p = i + 8 + nlen*2
                    sep = struct.unpack_from("<I", v, p)[0] if p+4 <= len(v) else None
                    if sep == 0 and p+8 <= len(v):
                        id1 = struct.unpack_from("<I", v, p+4)[0]
                        id2 = struct.unpack_from("<I", v, p+8)[0] if p+12 <= len(v) else None
                        # text first: id1 = textlen + printable UTF16 text
                        if 0 < id1 <= 60 and p+8+id1*2 <= len(v):
                            txt = v[p+8:p+8+id1*2]
                            if re.fullmatch(rb"(?:[\x20-\x7e]\x00){%d}" % id1, txt):
                                params[name] = txt.decode("utf-16-le")
                                i = p + 8 + id1*2
                                continue
                        # numeric: id1,id2 = unit-id pair (id2 == id1+1 observed), then f64
                        if 0 < id1 < 0x100 and id2 == id1 + 1 and p+20 <= len(v):
                            dbl = struct.unpack_from("<d", v, p+12)[0]
                            if abs(dbl) < 1e12 and dbl == dbl:
                                params[name] = dbl
                                i = p + 20
                                continue
        i += 1
    if params:
        return params
    # fallback: legacy name + display-string pairs
    strings = _scan_lp_strings(v)
    legacy = {}
    for idx in range(len(strings) - 1):
        (i1, t1), (i2, t2) = strings[idx], strings[idx + 1]
        if not re.match(r"^[A-Za-z][A-Za-z0-9_ ()\-]*$", t1):
            continue
        if re.match(r"^[\d.,\s]", t1):
            continue
        if not re.match(r"^[-+]?\d[\d.,\s]*([a-zA-Z\u00b0%]+)?$", t2):
            continue
        if i2 - i1 > 64:
            continue
        if re.match(r"^[\d.]+\s*(mm|Gauge|in|deg)", t1):
            continue
        legacy[t1] = t2
    return legacy


# ---------------- E1.5: expression/dependency graph (session 13) ---------------

def _scan_expression_graph(v):
    """Variable dependency graph: {var: [referenced var names]}.

    Structure (spec session 13): per-variable dependency lists stored as
    [u32 x][u32 namelen][NAME UTF-16] followed by flagged entries
    [0x8000|id][u32 len][NAME]... Each variable lists the variables
    created after it that it may reference. RDxVar* are feature vars.
    """
    graph = {}
    for p in range(0, len(v) - 32, 2):
        n2 = struct.unpack_from("<I", v, p + 4)[0]
        if not (2 <= n2 <= 60):
            continue
        name_raw = v[p + 8:p + 8 + n2 * 2]
        if not re.fullmatch(rb"(?:[\x20-\x7e]\x00){%d}" % n2, name_raw):
            continue
        name = name_raw.decode("utf-16-le")
        if not re.match(r"^[A-Za-z][A-Za-z0-9_]*$", name):
            continue
        q = p + 8 + n2 * 2
        refs = []
        while q + 8 <= len(v):
            raw = struct.unpack_from("<I", v, q)[0]
            if raw & 0x80000000:
                ln = struct.unpack_from("<I", v, q + 4)[0]
                if 0 < ln <= 40 and q + 8 + ln * 2 <= len(v):
                    nm = v[q + 8:q + 8 + ln * 2]
                    if re.fullmatch(rb"(?:[\x20-\x7e]\x00){%d}" % ln, nm):
                        ref = nm.decode("utf-16-le")
                        if re.match(r"^[A-Za-z][A-Za-z0-9_]*$", ref):
                            refs.append(ref)
                            q += 8 + ln * 2
                            continue
                break
            else:
                break
        if refs:
            graph.setdefault(name, refs)
    return graph


