def _find_asm_payload(ole):
    """Return the decompressed ASM BinaryFile4 payload, or None."""
    try:
        import zstandard
    except ImportError:
        return None
    for entry in ole.listdir(streams=True):
        path = "/".join(entry)
        if not path.startswith("RSeStorage/B"):
            continue
        v = ole.openstream(entry).read()
        i = v.find(ZSTD_MAGIC)
        if i < 0:
            continue
        try:
            out = zstandard.ZstdDecompressor().decompress(v[i:], max_output_size=50_000_000)
        except Exception:
            continue
        if b"ASM BinaryFile4" in out:
            return out
    return None


# ---------------- Assembly (.iam) decoders (sessions 16-16b) ----------------

def _assembly_payload(ole):
    """Return all decompressed RSeStorage/B* payloads that carry the
    assembly browser-tree grammar (class names like AmDocEntry)."""
    try:
        import zstandard
    except ImportError:
        return []
    out = []
    for entry in ole.listdir(streams=True):
        path = "/".join(entry)
        if not path.startswith("RSeStorage/B"):
            continue
        v = ole.openstream(entry).read()
        i = v.find(ZSTD_MAGIC)
        if i < 0:
            continue
        try:
            d = zstandard.ZstdDecompressor().decompress(v[i:], max_output_size=50_000_000)
        except Exception:
            continue
        out.append(d)
    return out

def _read_tree_entries(payload):
    """Parse the browser-tree record grammar (session 16):
        [u32 namelen][UTF16 name][u32 classlen][ASCII class name][refs...]
      Names are pure-ASCII UTF16. Records sit on 16-byte framing.
    """
    entries = []
    pos = 0
    b = payload
    n = len(b)
    while pos + 8 <= n:
        if b[pos:pos+4] == b"\x00\x00\x00\x00" and (pos % 16) == 0:
            pos += 4
            continue
        nl = struct.unpack_from("<I", b, pos)[0]
        if 1 <= nl <= 256 and pos + 4 + nl * 2 <= n:
            raw = b[pos+4:pos+4+nl*2]
            if (all(raw[i] < 0x80 for i in range(0, len(raw), 2))
                    and all(raw[i] == 0 for i in range(1, len(raw), 2))
                    and 0x20 <= raw[0] < 0x7f):
                name = raw.decode("utf-16-le")
                p2 = pos + 4 + nl * 2
                cl = struct.unpack_from("<I", b, p2)[0] if p2 + 4 <= n else -1
                if 1 <= cl <= 128 and p2 + 4 + cl <= n:
                    cls = b[p2+4:p2+4+cl]
                    if all(0x20 <= c < 0x7f for c in cls):
                        entries.append({"name": name, "class": cls.decode("latin1"), "offset": pos})
                        pos = p2 + 4 + cl
                        continue
        pos += 1
    return entries

def _utf16_ascii_name(b, p):
    """Return (name, next_pos) when a plausible record name sits at p,
    else (None, p). Record names here are pure-ASCII UTF16; the consumer
    must reject binary records that only look like names."""
    n = len(b)
    nl = struct.unpack_from("<I", b, p)[0]
    if not (2 <= nl <= 256) or p + 4 + nl * 2 > n:
        return None, p
    raw = b[p+4:p+4+nl*2]
    if not all(raw[i] < 0x80 and 0x20 <= raw[i] for i in range(0, len(raw), 2)):
        return None, p
    if not all(raw[i] == 0 for i in range(1, len(raw), 2)):
        return None, p
    return raw.decode("utf-16-le"), p + 4 + nl * 2

def _read_occurrence_records(payload):
    """Parse the occurrence/transform layer (session 16b).
    The payload reuses the ASM token stream plus occurrence records:
        [flags 02 00 00 30][u32 namelen][UTF16 name] ...
    plus inline f64 runs: identity or placed 3x4 transform matrices
    (row-major 12 doubles + trailing 0), GUIDs (16 bytes), and
    small-int parameter runs. The interesting matrix is the run that
    is neither all-zero nor the identity. Returns occurrences with
    name and 3x4 transform when one can be attributed.
    """
    occs = []
    b = payload
    n = len(b)
    pos = 0
    while pos + 12 <= n:
        if (b[pos] == 0x02 and b[pos+1] == 0x00 and b[pos+2] == 0x00 and b[pos+3] == 0x30):
            # [02 00 00 30][u32 0][u32 namelen][UTF16 name]
            name, nxt = _utf16_ascii_name(b, pos + 8)
            if name is not None:
                occs.append({"name": name, "offset": pos, "transform": None})
                pos = nxt
                continue
        pos += 1
    return occs

def _plausible_transform(vals):
    """A 13-double 0x42-tagged window: 12 transform doubles + trailing
    0. Accepted when all values are finite and within unit scale (these are
    axis-permutation placements: exact 0/+-1 entries in ground truth)."""
    if any(v != v for v in vals):
        return False
    if len(vals) >= 12 and max(abs(v) for v in vals[:12]) > 1.5:
        return False
    return len(vals) >= 12

def _scan_transforms(payload, occurrences):
    """Find occurrence transforms in the payload. Session 16b ground truth
    (assembly.iam): transforms are tagged '00 80 42 00' followed by 13
    doubles (12 transform values + trailing 0). The placed occurrence
    (Cyl:1, a 90-degree placement) carries a -1 z-entry; identity-placed
    occurrences carry zeros/identity. Per-occurrence attribution needs a
    translated sample, so all tagged windows are reported per-document."""
    b = payload
    tag = b"\x00\x80\x42\x00"
    out = []
    i = 0
    while True:
        i = b.find(tag, i)
        if i < 0:
            break
        base = i + 4
        if base + 104 <= len(b):
            vals = list(struct.unpack_from("<13d", b, base))
            if _plausible_transform(vals):
                out.append(vals[:12])
        i += 1
    for occ in occurrences:
        occ["transform"] = None
    placed = [t for t in out if not _is_identity(t)]
    return placed

def _is_identity(vals):
    """Identity or all-zero (unplaced) transform: nothing to report."""
    return all(abs(v) < 1e-9 for v in vals)

def _read_asm_entities(payload):
    """Parse the ASM binary entity stream -> list of entity dicts.

    Token grammar per spec sessions 6-8:
      11 <marker> <len> <name>  entity start
      0c <i32> ref | 04 <i32> int | 06 <f64> dbl | 07 <len><str> string
      0d/0e <len><name> subtype name | 0b flag
      13/14 + UNPADDED f64 block (geometry coords, session-8 verified)
    """
    b = payload
    i0 = b.find(b"ASM BinaryFile4")
    if i0 < 0:
        return []
    b = b[i0:]
    entities = []
    pos = 0
    current = None
    def i32(p): return struct.unpack_from("<i", b, p)[0]
    def f64(p): return struct.unpack_from("<d", b, p)[0]
    while pos < len(b) - 4:
        t = b[pos]
        if t == 0x11:
            ln = b[pos+2]
            name = b[pos+3:pos+3+ln].decode("latin1", "replace")
            current = {"type": name, "offset": pos, "refs": [], "ints": [],
                       "dbls": [], "names": [], "flags": 0, "blocks": []}
            entities.append(current)
            pos += 3 + ln
        elif t == 0x0c:
            if current is not None: current["refs"].append(i32(pos+1))
            pos += 5
        elif t == 0x04:
            if current is not None: current["ints"].append(i32(pos+1))
            pos += 5
        elif t == 0x06:
            if current is not None: current["dbls"].append(f64(pos+1))
            pos += 9
        elif t == 0x07:
            ln = b[pos+1]
            if current is not None: current["names"].append(b[pos+2:pos+2+ln])
            pos += 2 + ln
        elif t in (0x0d, 0x0e):
            ln = b[pos+1]
            if current is not None: current["names"].append(b[pos+2:pos+2+ln])
            pos += 2 + ln
        elif t == 0x0b:
            if current is not None: current["flags"] += 1
            pos += 1
        elif t in (0x13, 0x14):
            # double block: tag + UNPADDED f64s until next known tag
            # (session 8 byte-exact alignment: point=(1.0,0.0,0.0), plane=(0.5,0.5,0,0))
            p = pos + 1
            dbls = []
            while p + 8 <= len(b) and b[p] not in (0x11, 0x0c, 0x04, 0x06, 0x07, 0x0d, 0x0e, 0x0b, 0x13, 0x14):
                dbls.append(f64(p)); p += 8
            if current is not None: current["blocks"].append((hex(t), dbls))
            pos = p
        else:
            pos += 1  # tolerate unknown byte (history section has extra framing)
    return entities


class IptFile:
    def __init__(self, path):
        self.path = path
        self.ole = olefile.OleFileIO(path)
        self._streams = {}
        for entry in self.ole.listdir(streams=True):
            name = "/".join(entry)
            self._streams[name] = self.ole.openstream(entry).read()
        self._propsets = {}   # fmtid -> [(id,type,val)], merged across streams
        self._thumb = None
        for name, data in self._streams.items():
            if data[:8] == PROLOGUE:
                for fmtid, props in decode_property_set(data).items():
                    self._propsets.setdefault(fmtid, []).extend(props)
            if self._thumb is None and b"\x89PNG\r\n\x1a\n" in data[:1024]:
                i = data.find(b"\x89PNG\r\n\x1a\n")
                iend = data.rfind(b"IEND")
                if iend > 0:
                    self._thumb = data[i:iend + 8]

    def close(self):
        self.ole.close()

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()

    def props(self, fmtid):
        out = {}
        for pid, _typ, val in self._propsets.get(fmtid, []):
            out[pid] = val
        return out

    def design_tracking(self):
        return self.props("32853f0f-3444-11d1-9e93-0060b03c1ca6")

    def part_title(self):
        v = self.design_tracking().get(0x5)
        return v if isinstance(v, str) else None

    def author(self):
        v = self.design_tracking().get(0x29)
        return v if isinstance(v, str) else None

    def material(self):
        dt = self.design_tracking()
        info = {}
        lib = dt.get(0x47)
        if isinstance(lib, str):
            parts = lib.split("\n")
            info["library_ref"] = parts[0]
            if len(parts) > 1:
                info["material_id"] = parts[-1].lstrip("#")
        if isinstance(dt.get(0x14), str):
            info["material_name"] = dt[0x14]
        if isinstance(dt.get(0x48), str):
            info["appearance"] = dt[0x48]
        if isinstance(dt.get(0x3d), float):
            info["density_g_cm3"] = dt[0x3d]
        return info

    def inventor_build(self):
        v = self.design_tracking().get(0x43)
        return v if isinstance(v, str) else None

    def active_color_style_xml(self):
        for v in self.props("bb586990-af3e-11d3-95a9-00a0c9b6e37a").values():
            if isinstance(v, str) and v.startswith("<PartActiveColorStyle>"):
                return v
        return None

    def thumbnail(self):
        return self._thumb

    def ufrxdoc_records(self):
        return utf16_strings(self._streams.get("UFRxDoc", b""))

    def schemas(self):
        out = {}
        for s in self.ufrxdoc_records():
            for key in ("File Schema", "Software Schema"):
                if s.startswith(key + ":"):
                    out[key] = s.split(":", 1)[1].strip()
        return out

    def template_provenance(self):
        for s in self.ufrxdoc_records():
            if s.startswith("Document ") and " was created" in s:
                return s
        return None

    def rse_meta_version(self):
        for v in self._streams.values():
            m = re.search(rb"RSe Meta Stream Version (\d+)", v[:200])
            if m:
                return int(m.group(1))
        return None

    def rse_timestamps(self):
        ts = set()
        for name, v in self._streams.items():
            if name.startswith("RSeStorage/"):
                for s in ascii_strings(v, 8):
                    if re.match(r"^\d{2}/\d{2}/\d{4} \d{2}:\d{2}:\d{2}$", s):
                        ts.add(s)
        return sorted(ts)

    def locale(self):
        data = self._streams.get("RSeStorage/RSeEmbeddings/Contents", b"")
        for s in utf16_strings(data):
            if re.match(r"^[A-Z][a-z]+ \([A-Z][a-z]+\)$", s):
                return s
        return None

    def stream_inventory(self):
        rows = []
        for entry in self.ole.listdir(streams=True, storages=True):
            path = "/".join(entry)
            try:
                size = self.ole.get_size(entry)
            except Exception:
                size = None
            rows.append((path, size))
        return rows

    def all_properties(self):
        out = {}
        for fmtid, props in self._propsets.items():
            role = FMTID_ROLES.get(fmtid, fmtid)
            section = {}
            for pid, typ, val in props:
                label = PROP_NAMES_DSI.get(pid) or ("prop_%s" % hex(pid))
                if isinstance(val, bytes):
                    val = val.hex()
                if isinstance(val, str) and len(val) > 300:
                    val = val[:300] + "..."
                section[label] = val
            out[role] = section
        return out


    def parameters(self):
        """User parameters {name: equation_text} from the RSe B-rep payload.

        Requires the 'zstandard' module. Returns {} when absent or when the
        file has no user parameters.
        """
        if not hasattr(self, "_params"):
            self._params = {}
            for v in _inflate_b_streams(self.ole):
                self._params.update(_extract_parameters_from_payload(v))
        return self._params


    def parameter_links(self):
        """E1.5: variable dependency graph {var: [refs]} (or {})."""
        if not hasattr(self, "_plinks"):
            self._plinks = {}
            try:
                import zstandard
                for v in _inflate_b_streams(self.ole):
                    g = _scan_expression_graph(v)
                    if g:
                        self._plinks = g
                        break
            except Exception:
                pass
        return self._plinks

    def asm_entities(self):
        """ASM (ACIS-family) entities from the B-rep payload.

        Returns list of dicts (type, refs, ints, dbls, blocks...).
        Requires 'zstandard'. Empty list if absent or not an Inventor part
        with ASM data.
        """
        if not hasattr(self, "_asm"):
            payload = _find_asm_payload(self.ole)
            self._asm = _read_asm_entities(payload) if payload else []
        return self._asm

    def asm_topology_summary(self):
        """Counts of ASM entity types + first geometry block per entity."""
        from collections import Counter
        c = Counter(e["type"] for e in self.asm_entities())
        return dict(c)

    def assembly_tree(self):
        """Session 16: browser-tree entries [{name, class, offset}] from
        the .iam Bl2pnvpg-family payload. Empty for plain .ipt parts."""
        if not hasattr(self, "_amtree"):
            self._amtree = []
            if self.path.lower().endswith(".iam"):
                for v in _assembly_payload(self.ole):
                    ents = _read_tree_entries(v)
                    if len(ents) > len(self._amtree):
                        self._amtree = ents
                        self._amtree_payload = v
        return self._amtree

    def occurrences(self):
        """Session 16b: [{name, transform}] occurrence records from the
        .iam occurrence payload (names + the placed transform, which is
        reported per-document via placed_transform())."""
        if not hasattr(self, "_occs"):
            self._occs = []
            best = []
            best_payload = None
            if self.path.lower().endswith(".iam"):
                for v in _assembly_payload(self.ole):
                    occs = _read_occurrence_records(v)
                    if len(occs) > len(best):
                        best = occs
                        best_payload = v
            if best:
                self._placed = _scan_transforms(best_payload, best)
                self._occs = best
        return self._occs

    def placed_transform(self):
        """All non-identity 0x42-tagged 12-double transform windows found
        in the occurrence payload (raw values; row/column-major semantics
        pending one more ground-truth sample)."""
        if not hasattr(self, "_placed"):
            self._placed = []
            self.occurrences()
        return self._placed

    def asm_sketch_vertices(self):
        """Decoded point-entity coordinates (the explicit base topology).

        Uses the first 0x13-block with >= 3 doubles per point entity.
        """
        out = []
        for e in self.asm_entities():
            if e["type"] != "point":
                continue
            for tag, dbls in e["blocks"]:
                if tag == "0x13" and len(dbls) >= 3:
                    out.append(dbls[:3])
                    break
        return out

    def summary(self):
        s = {
            "file": os.path.basename(self.path),
            "part_title": self.part_title(),
            "parameters": self.parameters(),
            "parameter_links": self.parameter_links() or None,
            "asm_topology": self.asm_topology_summary() or None,
            "asm_vertices": self.asm_sketch_vertices() or None,
            "assembly_tree": self.assembly_tree() or None,
            "occurrences": self.occurrences() or None,
            "placed_transform": self.placed_transform(),
            "author": self.author(),
            "inventor_build": self.inventor_build(),
            "material": self.material(),
            "schemas": self.schemas(),
            "template_provenance": self.template_provenance(),
            "locale": self.locale(),
            "rse_meta_version": self.rse_meta_version(),
            "rse_save_timestamps": self.rse_timestamps(),
            "thumbnail_png": len(self._thumb) if self._thumb else None,
            "properties": self.all_properties(),
        }
        return s

def print_human(s):
    print(f"=== {s['file']} ===")
    print(f"  Title:            {s['part_title']}")
    if s.get('parameters'):
        for name, val in s['parameters'].items():
            print(f"  Parameter:        {name} = {val}")
    occs = s.get('occurrences')
    if occs:
        print(f"  Assembly tree ({len(occs)} entries):")
        for o in occs:
            print(f"    - {o['name']}")
    placed = s.get('placed_transform')
    if placed:
        for t in placed:
            print(f"  Placed transform: {[round(v, 4) for v in t]}")
    tree = s.get('assembly_tree')
    if tree:
        print(f"  Browser filters ({len(tree)}):")
        for e in tree:
            print(f"    - {e['name']} [{e['class']}")
    print(f"  Author:           {s['author']}")
    print(f"  Inventor build:   {s['inventor_build']}")
    m = s["material"]
    if m:
        print(f"  Material:         {m.get('material_name')} / {m.get('material_id')} "
              f"(density {m.get('density_g_cm3')} g/cm^3, appearance {m.get('appearance')})")
    print(f"  Locale:           {s['locale']}")
    print(f"  Schemas:          {s['schemas']}")
    print(f"  RSe version:      {s['rse_meta_version']}  saves: {s['rse_save_timestamps']}")
    if s["thumbnail_png"]:
        print(f"  Thumbnail:        yes ({s['thumbnail_png']} bytes PNG)")


def main():
    p = argparse.ArgumentParser(description="Extract metadata from Autodesk Inventor .ipt files")
    p.add_argument("files", nargs="+", help=".ipt file(s)")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--all", action="store_true", help="include full property dump (with --json)")
    p.add_argument("--thumbnail", metavar="PREFIX", help="save thumbnail(s) as PREFIX.png")
    p.add_argument("--inventory", action="store_true", help="dump OLE stream inventory")
    args = p.parse_args()

    rc = 0
    for path in args.files:
        try:
            with IptFile(path) as ipt:
                if args.inventory:
                    for stream, size in ipt.stream_inventory():
                        print(f"{size if size is not None else '-':>10}  {stream}")
                    continue
                s = ipt.summary()
                if not args.all:
                    s["properties"] = "(use --all to include)"
                if args.json:
                    print(json.dumps(s, indent=2, default=str))
                else:
                    print_human(s)
                    if args.all:
                        for role, section in s["properties"].items():
                            print(f"  [{role}]")
                            for k, v in section.items():
                                print(f"    {k}: {v}")
                if args.thumbnail:
                    png = ipt.thumbnail()
                    if png:
                        base = args.thumbnail
                        if len(args.files) > 1:
                            base = f"{args.thumbnail}_{os.path.splitext(os.path.basename(path))[0]}"
                        fn = f"{base}.png"
                        with open(fn, "wb") as f:
                            f.write(png)
                        print(f"  -> thumbnail saved: {fn}")
                    else:
                        print("  -> no thumbnail found", file=sys.stderr)
                        rc = 1
        except Exception as e:
            print(f"ERROR {path}: {e}", file=sys.stderr)
            rc = 1
    return rc


if __name__ == "__main__":
    sys.exit(main())
